# Налаштування сервера
PORT=3000
NODE_ENV=development

# Шлях до файлу SQLite бази даних
DB_PATH=./data/voltapro.db

# Тривалість сесії менеджера (у годинах)
SESSION_TTL_HOURS=12

# Сіль / секрет для підпису або додаткового захисту (для продакшену обов'язково змінити)
APP_SECRET=change-me-in-production-dev-only
